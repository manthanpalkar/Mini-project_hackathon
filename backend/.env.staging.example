# ==============================================================================
# LOOP Backend — Isolated Staging Environment Template
# ==============================================================================
# IMPORTANT:
# - All values below are placeholders. Never commit actual production secrets.
# - Staging must use a completely separate database from production.
# ==============================================================================

NODE_ENV=staging
PORT=5001

# Isolated Staging Database (Do NOT point to production 'databaseloop' cluster/database)
MONGODB_URI=mongodb+srv://<STAGING_DB_USER>:<STAGING_DB_PASSWORD>@<STAGING_CLUSTER>.mongodb.net/loop_staging?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Staging Cryptographic Secret (Must be >= 32 characters, completely distinct from production)
JWT_SECRET=<STAGING_JWT_SECRET_MIN_32_CHARACTERS_NEVER_USE_PROD_KEY>

# Staging Frontend Allowlist for CORS (Comma-separated)
ALLOWED_ORIGIN=https://loop-staging.vercel.app,http://localhost:5173,http://localhost:4173

# Google OAuth Credentials for Staging (Configured in Google Cloud Console with staging callback)
GOOGLE_CLIENT_ID=<STAGING_GOOGLE_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<STAGING_GOOGLE_CLIENT_SECRET>

# Optional Upstash Redis (Serverless TLS Staging Cache)
REDIS_URL=rediss://default:<STAGING_UPSTASH_TOKEN>@<STAGING_UPSTASH_HOST>.upstash.io:6379
REDIS_ENABLED=true
REDIS_TTL_STORIES=300
REDIS_TTL_STORY_DETAIL=600
REDIS_TTL_RESOURCES=300
REDIS_TTL_RESOURCE_DETAIL=600
REDIS_TTL_ACHIEVEMENTS=600
REDIS_TTL_FOLDERS=300

# Rate Limiting for Staging QA
RATE_LIMIT_GLOBAL_MAX=5000
RATE_LIMIT_LOGIN_MAX=50
RATE_LIMIT_REGISTER_MAX=50
RATE_LIMIT_UPLOAD_MAX=100
RATE_LIMIT_DOWNLOAD_MAX=200

# MongoDB GridFS Storage Configuration (Unified Single Database Storage)
GRIDFS_BUCKET_NAME=loop_resources
GRIDFS_CHUNK_SIZE_MB=8
GRIDFS_UPLOAD_CONCURRENCY=6
RESUME_MAX_FILE_SIZE_BYTES=10485760
