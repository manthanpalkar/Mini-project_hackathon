PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
ALLOWED_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis Caching (Optional - Automatically degrades to MongoDB if unconfigured or offline)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_TTL_STORIES=300
REDIS_TTL_STORY_DETAIL=600
REDIS_TTL_RESOURCES=300
REDIS_TTL_RESOURCE_DETAIL=600
REDIS_TTL_ACHIEVEMENTS=600
REDIS_TTL_FOLDERS=300

# MongoDB GridFS Storage Configuration (Unified Single Database Storage)
# All files, resumes, and study materials are stored directly in MongoDB Atlas GridFS
GRIDFS_BUCKET_NAME=loop_resources
GRIDFS_CHUNK_SIZE_MB=8
GRIDFS_UPLOAD_CONCURRENCY=6

# Storage Size Limits
# Resume limit: Strictly 10 MiB (10,485,760 bytes) - PDF documents only
RESUME_MAX_FILE_SIZE_BYTES=10485760
# Study Material limit: No arbitrary application-level limit; streamed directly to MongoDB GridFS chunks
