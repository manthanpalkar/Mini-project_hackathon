PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
ALLOWED_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis Caching (Optional - Automatically degrades to MongoDB if unconfigured or offline)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_TTL_STORIES=300
REDIS_TTL_STORY_DETAIL=600
REDIS_TTL_RESOURCES=300
REDIS_TTL_RESOURCE_DETAIL=600
REDIS_TTL_ACHIEVEMENTS=600
REDIS_TTL_FOLDERS=300

# Supabase Storage Configuration (Private Buckets for Resumes & Study Materials)
# Obtain these from your Supabase Project Settings -> Project URL & Project API Keys
SUPABASE_URL=https://your-project-id.supabase.co
# SECURITY CRITICAL: Keep service-role key exclusively on the backend; never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Storage Bucket Names (Private buckets with authenticated / signed URL access)
SUPABASE_RESUME_BUCKET=resumes
SUPABASE_STUDY_MATERIAL_BUCKET=study-materials

# Storage Size Limits
# Resume limit: Strictly 10 MB (10,485,760 bytes) - PDF documents only
RESUME_MAX_FILE_SIZE_BYTES=10485760

# Study Material limit: Configurable based on your Supabase Plan
# - Supabase Free Plan limit: 50 MB (52,428,800 bytes)
# - Supabase Pro Plan limit: up to 5 GB (with TUS resumable / multipart uploads)
STUDY_MATERIAL_MAX_FILE_SIZE_BYTES=52428800
