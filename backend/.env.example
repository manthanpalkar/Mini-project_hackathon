PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/loop_universe_dev?retryWrites=true&w=majority
JWT_SECRET=your_minimum_32_character_cryptographically_secure_jwt_secret
RESET_SECRET=your_minimum_32_character_cryptographically_secure_reset_secret
ALLOWED_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis Caching (Optional - Automatically degrades to in-memory/disabled if unconfigured or offline)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
REDIS_TTL_STORIES=300
REDIS_TTL_STORY_DETAIL=600
REDIS_TTL_RESOURCES=300
REDIS_TTL_RESOURCE_DETAIL=600
REDIS_TTL_ACHIEVEMENTS=600
REDIS_TTL_FOLDERS=300

# MongoDB GridFS Storage Configuration (Unified Single Database Storage)
GRIDFS_BUCKET_NAME=loop_resources
GRIDFS_CHUNK_SIZE_MB=8
GRIDFS_UPLOAD_CONCURRENCY=6

# Storage Size Limits
RESUME_MAX_FILE_SIZE_BYTES=10485760
