# Ignore dependencies and build artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment variables and secrets
.env
.env.*
!.env.example

# Ignore tests, logs, and development fixtures
tests/
backups/
coverage/
*.log
.DS_Store

# Ignore git metadata
.git/
.gitignore
