# ==============================================================================
# LOOP SPIT — Environment Configuration Template
# 
# IMPORTANT: All placeholder values (<...>, "your-...", "xkeysib-...") MUST be
# replaced with genuine institutional credentials before production deployment.
# Leaving placeholder credentials will cause container healthchecks or authentication to fail.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Ports
# ------------------------------------------------------------------------------
NODE_ENV=production
FRONTEND_PORT=80
BACKEND_PORT=5001
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas + GridFS)
# ------------------------------------------------------------------------------
# Connection string pointing to your MongoDB Atlas cluster
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_name>.mongodb.net/loop?retryWrites=true&w=majority

# GridFS bucket for file storage (resumes & study materials)
GRIDFS_BUCKET_NAME=loop_resources
GRIDFS_CHUNK_SIZE_MB=8
GRIDFS_UPLOAD_CONCURRENCY=6
RESUME_MAX_FILE_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# Security & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Must be at least 32 characters long (e.g., generated with `openssl rand -hex 32`)
JWT_SECRET=your_minimum_32_character_cryptographically_secure_jwt_secret
RESET_SECRET=your_minimum_32_character_cryptographically_secure_reset_secret

# Allowed CORS origins (comma-separated if multiple)
ALLOWED_ORIGIN=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Institutional @spit.ac.in Sign-In)
# ------------------------------------------------------------------------------
# Note: Prebuilt GHCR frontend images have the official SPIT Client ID baked in at CI build.
# If running prebuilt images, set GOOGLE_CLIENT_ID to the official SPIT client ID:
# 779605241663-vp20b6cbhoccdeibjlcbtp7d9kbcf5bu.apps.googleusercontent.com
# If you require a custom college Client ID, rebuild locally: docker compose up -d --build
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Brevo SMTP Configuration (Transactional Password Reset Verification Codes)
# ------------------------------------------------------------------------------
# Brevo API v3 key starting with xkeysib-
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_placeholder
EMAIL_FROM=swapnil.patil24@spit.ac.in

# ------------------------------------------------------------------------------
# Redis Caching (Bundled in Docker Compose; degrades safely to MongoDB if offline)
# ------------------------------------------------------------------------------
# For Docker Compose deployments, use REDIS_URL=redis://redis:6379
# For bare-metal local development outside Docker, use REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
REDIS_TTL_STORIES=300
REDIS_TTL_STORY_DETAIL=600
REDIS_TTL_RESOURCES=300
REDIS_TTL_RESOURCE_DETAIL=600
REDIS_TTL_ACHIEVEMENTS=600
REDIS_TTL_FOLDERS=300
